---
import Layout from '../../layouts/Layout.astro'
export const prerender = true;
const seoData = {
  title: 'Wholesale — Artilate',
  description: 'Partner with Artilate for curated chocolate assortments, custom co-branding, Colombian cacao beans, and Alberta-first logistics.',
  noindex: false
}

const products = [
  {
    name: 'Pistachio',
    badge: '⭐ Customer Favourite',
    badgeClass: 'badge-star',
    cacao: '70%',
    weight: '12 g',
    calories: 60,
    notes: 'Creamy and well-balanced with a pronounced pistachio character (30%). Nutty and gently buttery notes lead, supported by smooth dark chocolate and soft sweetness, finishing clean and elegant.',
    alcohol: false,
  },
  {
    name: 'Chocolate & Hazelnut',
    badge: null,
    badgeClass: '',
    cacao: '70%',
    weight: '12 g',
    calories: 70,
    notes: 'Creamy and well-balanced with a clear roasted hazelnut character. Nutty and slightly toasted notes are supported by smooth chocolate and gentle sweetness, with a clean rounded finish.',
    alcohol: false,
  },
  {
    name: 'Spicy Pineapple',
    badge: '🔥 Unique Creation',
    badgeClass: 'badge-fire',
    cacao: '70%',
    weight: '12 g',
    calories: 50,
    notes: 'Bright Colombian pineapple with fresh sweet-tart acidity layered with natural smoky chiles — morita and pasilla from Oaxaca — adding warm earthy depth. Balanced sweetness and gentle spice with a long vibrant finish.',
    alcohol: false,
  },
  {
    name: 'Caramel & Blackberry',
    badge: '🏆 Expert Selected',
    badgeClass: 'badge-trophy',
    cacao: '70%',
    weight: '12 g',
    calories: 60,
    notes: 'Smooth caramel paired with Colombian Andean blackberry creates a bright tart contrast and elegant balance. Recently featured by CBC Life.',
    alcohol: false,
  },
  {
    name: 'Passion Fruit',
    badge: null,
    badgeClass: '',
    cacao: '70%',
    weight: '12 g',
    calories: 50,
    notes: 'Bold and intensely flavoured, highlighting the true character of real passion fruit. Bright tropical acidity balanced by smooth ganache with a lively tropical finish.',
    alcohol: false,
  },
  {
    name: 'Mango',
    badge: null,
    badgeClass: '',
    cacao: '70%',
    weight: '12 g',
    calories: 50,
    notes: 'Smooth tropical mango with natural sweetness and ripe fruit notes. Warm, rounded mango flavour balanced by a creamy ganache with gentle acidity and a soft tropical finish.',
    alcohol: false,
  },
  {
    name: 'Chai Latte',
    badge: null,
    badgeClass: '',
    cacao: '70%',
    weight: '12 g',
    calories: 50,
    notes: 'Ganache made with milk chocolate infused with traditional chai spices. Warm notes of cinnamon and cardamom blend with the creaminess of milk chocolate for a rich and comforting flavour.',
    alcohol: false,
  },
  {
    name: 'Coffee',
    badge: '☕ Signature',
    badgeClass: 'badge-coffee',
    cacao: '70%',
    weight: '12 g',
    calories: 50,
    notes: 'Made with 100% Arabica coffee from Colombia. Clean, aromatic profile with bright notes, deep roasted character, and a smooth balanced finish, enhanced by the warmth of milk chocolate ganache.',
    alcohol: false,
  },
  {
    name: 'Matcha Berry Bloom',
    badge: null,
    badgeClass: '',
    cacao: '70%',
    weight: '12 g',
    calories: 45,
    notes: 'Aromatic and floral with a smooth green matcha base. Lavender and butterfly pea flower–infused cream add soft botanical notes, while raspberry sugar brings a bright fruity lift. Elegant and well balanced.',
    alcohol: false,
  },
  {
    name: 'Dark Chocolate & Rum Liqueur',
    badge: null,
    badgeClass: '',
    cacao: '70%',
    weight: '12 g',
    calories: 45,
    notes: 'Rich dark chocolate ganache infused with rum liqueur. Deep cocoa notes blend with warm rum character for a bold and smooth flavour. Intense, elegant, and lingering with a warm finish.',
    alcohol: true,
  },
  {
    name: 'Whiskey Cream',
    badge: '⭐ Customer Favourite',
    badgeClass: 'badge-star',
    cacao: '70%',
    weight: '12 g',
    calories: 30,
    notes: 'Creamy ganache with whiskey cream liqueur and milk chocolate. Smooth caramel and vanilla notes create a soft and rounded flavour. Rich, comforting, and velvety with a gentle whiskey finish.',
    alcohol: true,
  },
  {
    name: 'Passion Fruit & Amaretto',
    badge: null,
    badgeClass: '',
    cacao: '70%',
    weight: '12 g',
    calories: 40,
    notes: 'Bright passion fruit ganache infused with amaretto liqueur. Vibrant tropical acidity is balanced by soft almond sweetness. Fresh, aromatic, and smooth with a long fruity finish.',
    alcohol: true,
  },
];
---

<Layout {...seoData}>
  <main class="wholesale-page">

    <!-- ═══════════  HERO  ═══════════ -->
    <section class="ws-hero">
      <div class="hero-overlay"></div>
      <div class="hero-particles" aria-hidden="true">
        <span class="hp hp1"></span><span class="hp hp2"></span><span class="hp hp3"></span>
        <span class="hp hp4"></span><span class="hp hp5"></span><span class="hp hp6"></span>
      </div>
      <div class="container hero-inner">
        <p class="hero-eyebrow">Wholesale & B2B</p>
        <h1 class="hero-title">Partner with Artilate</h1>
        <p class="hero-sub">Artisan chocolate for retail, hotels, corporate gifting, and events — handcrafted in Alberta from single-origin Colombian cacao by a certified chocolatier & food safety expert.</p>
        <div class="hero-pills">
          <span class="pill">🌿 100% Real Chocolate</span>
          <span class="pill">🇨🇦 Made in Alberta</span>
          <span class="pill">☕ Small Batches</span>
          <span class="pill">🌎 Colombian Cacao</span>
        </div>
        <div class="hero-actions">
          <a href="#wholesale-form" class="hero-cta-primary">Request Catalog&ensp;↓</a>
          <a href="/beans" class="hero-cta-secondary">Colombian Cacao Beans →</a>
        </div>
      </div>
    </section>

    <!-- ═══════════  BEANS BANNER  ═══════════ -->
    <section class="beans-banner">
      <div class="container banner-inner">
        <div class="banner-text">
          <span class="banner-tag">New</span>
          <h2>Colombian Cacao Beans</h2>
          <p>We sell fine-aroma cacao beans sourced directly from Colombian farms. Ideal for chocolatiers, pastry shops, and artisan producers. Single-origin, fermented & dried at source.</p>
          <a href="/beans" class="banner-link">View varieties & pricing →</a>
        </div>
        <div class="banner-visual" aria-hidden="true">
          <svg viewBox="0 0 140 140" class="bean-svg">
            <ellipse cx="70" cy="70" rx="38" ry="52" fill="none" stroke="var(--gold)" stroke-width="1.5" opacity=".35" transform="rotate(-18 70 70)"/>
            <path d="M70,22 Q67,70 70,118" stroke="var(--gold)" stroke-width="1.2" fill="none" opacity=".5"/>
            <ellipse cx="70" cy="70" rx="26" ry="40" fill="none" stroke="var(--amber)" stroke-width=".8" opacity=".2" transform="rotate(-18 70 70)"/>
          </svg>
        </div>
      </div>
    </section>

    <!-- ═══════════  CACAO STORY  ═══════════ -->
    <section class="ws-story">
      <div class="container story-inner">
        <div class="section-header">
          <p class="section-eyebrow">From Colombian Forest to Finished Chocolate</p>
          <h2>Why Our Chocolate Is Different</h2>
        </div>
        <div class="story-grid">
          <div class="story-card">
            <div class="story-icon">🌍</div>
            <h3>Origin Matters</h3>
            <p>Cacao expresses terroir — just like wine. Colombian soil and climate shape a sensory profile that's impossible to replicate.</p>
          </div>
          <div class="story-card">
            <div class="story-icon">⚗️</div>
            <h3>Beyond Cocoa Percentage</h3>
            <p>Intensity matters, but balance defines quality. Fermentation, roasting, and craftsmanship shape every tasting note.</p>
          </div>
          <div class="story-card">
            <div class="story-icon">🤲</div>
            <h3>Small-Batch Craft</h3>
            <p>Small-batch production preserves the delicate aromas lost in mass production. Every bonbon is handmade by a certified chocolatier.</p>
          </div>
          <div class="story-card">
            <div class="story-icon">✨</div>
            <h3>Sensory Profile</h3>
            <p>Smooth and creamy with deep cocoa body, pronounced nutty notes, light fruit and floral hints, balanced acidity, and a clean persistent finish.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════  PRODUCTS  ═══════════ -->
    <section class="ws-products">
      <div class="container">
        <div class="section-header">
          <p class="section-eyebrow">The Collection</p>
          <h2>Single-Origin Colombian Chocolate • 70%</h2>
          <p class="section-sub">All bonbons are 12 g per piece. Made in Canada using domestic and imported ingredients. Cacao beans responsibly sourced from Colombia.</p>
        </div>

        <div class="products-legend">
          <span class="legend-item"><span class="badge badge-star">⭐ Customer Favourite</span></span>
          <span class="legend-item"><span class="badge badge-coffee">☕ Signature</span></span>
          <span class="legend-item"><span class="badge badge-trophy">🏆 Expert Selected</span></span>
          <span class="legend-item"><span class="badge badge-fire">🔥 Unique Creation</span></span>
        </div>

        <div class="products-grid">
          {products.map((p) => (
            <article class="product-card">
              {p.badge && <span class={`badge ${p.badgeClass}`}>{p.badge}</span>}
              {p.alcohol && <span class="badge badge-alcohol">🍷 Contains Alcohol</span>}
              <div class="product-header">
                <h3>{p.name}</h3>
                <span class="product-cacao">{p.cacao} Cacao</span>
              </div>
              <p class="product-notes">{p.notes}</p>
              <div class="product-meta">
                <span>Net Weight: {p.weight}</span>
                <span>{p.calories} cal / piece</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════  VALUE PROPS  ═══════════ -->
    <section class="ws-features">
      <div class="container">
        <div class="section-header">
          <p class="section-eyebrow">Wholesale Chocolate</p>
          <h2>What We Offer</h2>
        </div>
        <div class="features-grid">
          <article class="feat-card">
            <div class="feat-number">01</div>
            <h3>Curated Assortments</h3>
            <p>Best-sellers and seasonal sets designed for high sell-through and shelf appeal. 12 flavours including fruit, spiced, and liqueur collections.</p>
          </article>
          <article class="feat-card">
            <div class="feat-number">02</div>
            <h3>Lead Times</h3>
            <p>Typically 2–4 weeks depending on volume and seasonality. Rush options subject to availability. Call us at (587) 700-3560.</p>
          </article>
          <article class="feat-card">
            <div class="feat-number">03</div>
            <h3>MOQs & Pricing</h3>
            <p>MOQ varies by product; tiered pricing for scale. Request our current catalog for full details and wholesale terms.</p>
          </article>
          <article class="feat-card">
            <div class="feat-number">04</div>
            <h3>Alberta-First Logistics</h3>
            <p>Produced locally in Alberta. Ideal for Alberta retailers, hotels, corporate gifting, and events. Fast regional turnaround.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ═══════════  WHOLESALE FORM (Netlify)  ═══════════ -->
    <section class="ws-form-section" id="wholesale-form">
      <div class="container form-container">
        <div class="form-intro">
          <h2>Wholesale Inquiry</h2>
          <p>Tell us about your business and we'll send you our catalog, pricing, and terms.</p>
          <div class="form-contact-row">
            <a href="tel:5877003560" class="contact-chip">📞 (587) 700-3560</a>
            <a href="mailto:admin@artilate.com" class="contact-chip">✉️ admin@artilate.com</a>
          </div>
        </div>

        <form
          name="wholesale-inquiry"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="inquiry-form"
        >
          <input type="hidden" name="form-name" value="wholesale-inquiry" />
          <p class="hidden-honey" aria-hidden="true">
            <label>Don't fill this out: <input name="bot-field" /></label>
          </p>

          <div class="form-row">
            <div class="field">
              <label for="ws-name">Name</label>
              <input type="text" id="ws-name" name="name" required placeholder="Your name" />
            </div>
            <div class="field">
              <label for="ws-email">Email</label>
              <input type="email" id="ws-email" name="email" required placeholder="you@company.com" />
            </div>
          </div>

          <div class="form-row">
            <div class="field">
              <label for="ws-company">Company / Business</label>
              <input type="text" id="ws-company" name="company" placeholder="Your business name" />
            </div>
            <div class="field">
              <label for="ws-interest">Interest</label>
              <select id="ws-interest" name="interest">
                <option value="">Select…</option>
                <option value="chocolate">Wholesale Chocolate</option>
                <option value="beans">Cacao Beans</option>
                <option value="both">Both</option>
                <option value="gifting">Corporate Gifting</option>
                <option value="events">Events</option>
                <option value="other">Other</option>
              </select>
            </div>
          </div>

          <div class="field full-width">
            <label for="ws-details">Anything else?</label>
            <textarea id="ws-details" name="details" rows="3" placeholder="Volume estimates, product interests (Pistachio, Rum, Whiskey Cream…), timeline…"></textarea>
          </div>

          <button type="submit" class="primary-btn submit-btn">Send Inquiry</button>
        </form>
      </div>
    </section>

    <!-- ═══════════  BOTTOM CTA  ═══════════ -->
    <section class="ws-bottom">
      <div class="container bottom-row">
        <a href="/events" class="bottom-link">Corporate Events →</a>
        <a href="/beans" class="bottom-link">Cacao Beans →</a>
        <a href="/contact" class="bottom-link">General Contact →</a>
      </div>
    </section>

  </main>

  <style>
    :root {
      --cacao:#0A0B0D; --ivory:#FAFAF9; --gold:#D4A373; --amber:#F59E0B;
      --rose:#C9A9A6; --muted:rgba(250,250,249,.65); --glass:rgba(20,22,24,.55);
    }
    body{ background:var(--cacao); color:var(--ivory); line-height:1.6; overflow-x:hidden; }
    .container{ max-width:1200px; margin:0 auto; padding:0 2rem; }
    .hidden-honey{ display:none; }

    /* ── HERO ── */
    .ws-hero{
      position:relative; min-height:88vh; display:flex; align-items:center; justify-content:center;
      text-align:center; overflow:hidden;
      background:
        radial-gradient(ellipse at 25% 25%, rgba(212,163,115,.08) 0%, transparent 55%),
        radial-gradient(ellipse at 75% 70%, rgba(201,169,166,.07) 0%, transparent 55%),
        var(--cacao);
    }
    .hero-overlay{
      position:absolute; inset:0;
      background:repeating-linear-gradient(135deg, transparent, transparent 60px, rgba(212,163,115,.012) 60px, rgba(212,163,115,.012) 61px);
      pointer-events:none;
    }
    .hero-particles{ position:absolute; inset:0; pointer-events:none; }
    .hp{ position:absolute; width:5px; height:5px; border-radius:50%; background:var(--gold); opacity:0; animation:sparkle 5s ease-in-out infinite; }
    .hp1{ top:15%; left:20%; animation-delay:0s }
    .hp2{ top:30%; left:80%; animation-delay:.8s }
    .hp3{ top:70%; left:15%; animation-delay:1.6s }
    .hp4{ top:80%; left:75%; animation-delay:2.4s }
    .hp5{ top:45%; left:88%; animation-delay:3.2s }
    .hp6{ top:85%; left:50%; animation-delay:4s }
    @keyframes sparkle{
      0%,100%{ opacity:0; transform:scale(.6) translateY(0) }
      50%{ opacity:.5; transform:scale(1.1) translateY(-14px) }
    }
    .hero-inner{ position:relative; z-index:2; max-width:760px; }
    .hero-eyebrow{
      font-family:'Cormorant Garamond','Playfair Display',serif;
      font-size:1.1rem; letter-spacing:.18em; text-transform:uppercase; color:var(--rose);
      opacity:0; animation:fadeUp .8s ease-out .3s forwards;
    }
    .hero-title{
      font-family:'Playfair Display',serif; font-size:clamp(2.4rem,6vw,4.2rem);
      font-weight:600; margin:.3rem 0 1rem;
      background:linear-gradient(135deg, var(--ivory) 30%, var(--gold) 100%);
      -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;
      opacity:0; animation:fadeUp .9s ease-out .6s forwards;
    }
    .hero-sub{
      font-size:1.1rem; color:var(--muted); max-width:580px; margin:0 auto 1.5rem;
      line-height:1.75; opacity:0; animation:fadeUp .8s ease-out .9s forwards;
    }
    .hero-pills{
      display:flex; gap:.6rem; justify-content:center; flex-wrap:wrap; margin-bottom:2rem;
      opacity:0; animation:fadeUp .8s ease-out 1.05s forwards;
    }
    .pill{
      font-size:.78rem; letter-spacing:.05em; padding:5px 14px; border-radius:30px;
      border:1px solid rgba(212,163,115,.25); color:var(--gold); background:rgba(212,163,115,.06);
    }
    .hero-actions{
      display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;
      opacity:0; animation:fadeUp .8s ease-out 1.2s forwards;
    }
    .hero-cta-primary{
      display:inline-block; padding:14px 34px; border-radius:60px;
      background:linear-gradient(135deg,var(--gold),var(--amber)); color:var(--cacao);
      text-decoration:none; font-weight:700; letter-spacing:.04em;
      box-shadow:0 8px 28px rgba(212,163,115,.3);
      transition:all .4s cubic-bezier(.16,1,.3,1);
    }
    .hero-cta-primary:hover{ transform:translateY(-2px); box-shadow:0 12px 36px rgba(212,163,115,.45); }
    .hero-cta-secondary{
      display:inline-block; padding:14px 34px; border:1px solid var(--gold); border-radius:60px;
      color:var(--gold); text-decoration:none; font-weight:600; letter-spacing:.04em;
      transition:all .4s cubic-bezier(.16,1,.3,1);
    }
    .hero-cta-secondary:hover{ background:var(--gold); color:var(--cacao); transform:translateY(-2px); }
    @keyframes fadeUp{ to{ opacity:1; transform:translateY(0) } }
    .hero-eyebrow,.hero-sub,.hero-actions,.hero-pills{ transform:translateY(18px); }
    .hero-title{ transform:translateY(24px); }

    /* ── BEANS BANNER ── */
    .beans-banner{
      padding:3.5rem 0;
      background:linear-gradient(180deg, rgba(212,163,115,.04) 0%, transparent 100%);
    }
    .banner-inner{
      display:flex; align-items:center; gap:2.5rem;
      border:1px solid rgba(212,163,115,.2); background:rgba(212,163,115,.04);
      backdrop-filter:blur(8px); border-radius:20px; padding:2rem 2.5rem;
      transition:border-color .35s;
    }
    .banner-inner:hover{ border-color:rgba(212,163,115,.35); }
    .banner-text{ flex:1; }
    .banner-tag{
      display:inline-block; font-size:.7rem; letter-spacing:.12em; text-transform:uppercase;
      color:var(--cacao); background:var(--gold); padding:3px 10px; border-radius:20px;
      font-weight:700; margin-bottom:.75rem;
    }
    .banner-text h2{
      font-family:'Playfair Display',serif; font-size:clamp(1.3rem,2.5vw,1.8rem);
      margin:0 0 .5rem; line-height:1.3;
    }
    .banner-text p{ color:var(--muted); font-size:.95rem; line-height:1.6; margin:0 0 1rem; }
    .banner-link{
      color:var(--gold); text-decoration:none; font-weight:600; font-size:.95rem;
      transition:opacity .3s;
    }
    .banner-link:hover{ opacity:.7; }
    .banner-visual{ flex-shrink:0; }
    .bean-svg{ width:100px; height:100px; }

    /* ── STORY ── */
    .ws-story{ padding:5rem 0; }
    .story-grid{
      display:grid; grid-template-columns:repeat(2,1fr); gap:1.25rem;
      max-width:900px; margin:2rem auto 0;
    }
    .story-card{
      border:1px solid rgba(212,163,115,.14); background:var(--glass); backdrop-filter:blur(8px);
      border-radius:16px; padding:1.75rem 1.5rem;
      transition:border-color .35s, transform .35s;
    }
    .story-card:hover{ border-color:rgba(212,163,115,.3); transform:translateY(-3px); }
    .story-icon{ font-size:1.8rem; margin-bottom:.6rem; }
    .story-card h3{ font-size:1.05rem; margin:0 0 .4rem; }
    .story-card p{ color:var(--muted); font-size:.9rem; line-height:1.6; margin:0; }

    /* ── PRODUCTS ── */
    .ws-products{ padding:5rem 0; }
    .section-sub{ color:var(--muted); font-size:.9rem; max-width:620px; margin:.5rem auto 0; text-align:center; }
    .products-legend{
      display:flex; gap:.75rem; justify-content:center; flex-wrap:wrap; margin:1.5rem 0 2rem;
    }
    .legend-item{ display:flex; align-items:center; }
    .badge{
      display:inline-block; font-size:.7rem; letter-spacing:.06em;
      padding:3px 10px; border-radius:20px; font-weight:700;
      white-space:nowrap;
    }
    .badge-star{ background:rgba(212,163,115,.15); color:var(--gold); border:1px solid rgba(212,163,115,.3); }
    .badge-coffee{ background:rgba(120,70,30,.25); color:#d4956a; border:1px solid rgba(180,100,50,.3); }
    .badge-trophy{ background:rgba(245,158,11,.1); color:var(--amber); border:1px solid rgba(245,158,11,.3); }
    .badge-fire{ background:rgba(220,50,30,.1); color:#f87171; border:1px solid rgba(220,50,30,.3); }
    .badge-alcohol{ background:rgba(150,80,180,.1); color:#c084fc; border:1px solid rgba(150,80,180,.25); }
    .products-grid{
      display:grid; grid-template-columns:repeat(3,1fr); gap:1.25rem;
    }
    .product-card{
      border:1px solid rgba(212,163,115,.14); background:var(--glass); backdrop-filter:blur(8px);
      border-radius:16px; padding:1.5rem 1.4rem; display:flex; flex-direction:column; gap:.75rem;
      transition:border-color .35s, transform .35s;
      position:relative;
    }
    .product-card:hover{ border-color:rgba(212,163,115,.35); transform:translateY(-3px); }
    .product-header{ display:flex; align-items:flex-start; justify-content:space-between; gap:.5rem; }
    .product-header h3{ font-size:1.05rem; margin:0; line-height:1.3; }
    .product-cacao{
      font-size:.7rem; letter-spacing:.08em; text-transform:uppercase; color:var(--gold);
      background:rgba(212,163,115,.1); border:1px solid rgba(212,163,115,.2);
      border-radius:20px; padding:2px 8px; white-space:nowrap; flex-shrink:0;
    }
    .product-notes{ color:var(--muted); font-size:.87rem; line-height:1.6; margin:0; flex:1; }
    .product-meta{
      display:flex; gap:1rem; font-size:.78rem; color:rgba(250,250,249,.4);
      border-top:1px solid rgba(212,163,115,.1); padding-top:.6rem; margin-top:auto;
    }

    /* ── FEATURES ── */
    .ws-features{ padding:5rem 0; }
    .section-header{ text-align:center; margin-bottom:2.5rem; }
    .section-eyebrow{
      font-family:'Cormorant Garamond','Playfair Display',serif;
      font-size:.95rem; letter-spacing:.16em; text-transform:uppercase; color:var(--rose); margin-bottom:.35rem;
    }
    .section-header h2{
      font-family:'Playfair Display',serif; font-size:clamp(1.5rem,3vw,2.2rem);
    }
    .features-grid{
      display:grid; grid-template-columns:repeat(2, 1fr); gap:1.25rem;
      max-width:900px; margin:0 auto;
    }
    .feat-card{
      border:1px solid rgba(212,163,115,.16); background:var(--glass); backdrop-filter:blur(8px);
      border-radius:16px; padding:1.5rem 1.4rem;
      transition:border-color .35s, transform .35s;
    }
    .feat-card:hover{ border-color:rgba(212,163,115,.35); transform:translateY(-3px); }
    .feat-number{
      font-family:'Cormorant Garamond','Playfair Display',serif;
      font-size:1.8rem; font-weight:700; color:var(--gold); opacity:.5; line-height:1; margin-bottom:.5rem;
    }
    .feat-card h3{ font-size:1.05rem; margin:0 0 .35rem; }
    .feat-card p{ color:var(--muted); font-size:.9rem; line-height:1.55; margin:0; }

    /* ── FORM ── */
    .ws-form-section{
      padding:5rem 0;
      background:
        radial-gradient(ellipse at 50% 0%, rgba(201,169,166,.07) 0%, transparent 60%),
        linear-gradient(180deg, rgba(212,163,115,.03) 0%, transparent 40%);
    }
    .form-container{ max-width:700px; }
    .form-intro{ text-align:center; margin-bottom:2.5rem; }
    .form-intro h2{
      font-family:'Playfair Display',serif; font-size:clamp(1.5rem,3vw,2.1rem); margin-bottom:.6rem;
    }
    .form-intro p{ color:var(--muted); max-width:460px; margin:0 auto .75rem; }
    .form-contact-row{ display:flex; gap:.75rem; justify-content:center; flex-wrap:wrap; margin-top:.75rem; }
    .contact-chip{
      color:var(--gold); text-decoration:none; font-size:.88rem; font-weight:600;
      padding:6px 16px; border:1px solid rgba(212,163,115,.25); border-radius:30px;
      transition:all .3s;
    }
    .contact-chip:hover{ background:rgba(212,163,115,.1); }
    .inquiry-form{ display:flex; flex-direction:column; gap:1.25rem; }
    .form-row{ display:grid; grid-template-columns:1fr 1fr; gap:1.25rem; }
    .field{ display:flex; flex-direction:column; gap:.35rem; }
    .field.full-width{ grid-column:1/-1; }
    label{ font-size:.82rem; letter-spacing:.06em; text-transform:uppercase; color:var(--muted); }
    input,select,textarea{
      background:var(--glass); border:1px solid rgba(212,163,115,.18); border-radius:10px;
      padding:12px 14px; color:var(--ivory); font-size:.95rem; font-family:inherit;
      transition:border-color .3s, box-shadow .3s;
    }
    input::placeholder,textarea::placeholder{ color:rgba(250,250,249,.3); }
    input:focus,select:focus,textarea:focus{
      outline:none; border-color:var(--gold);
      box-shadow:0 0 0 3px rgba(212,163,115,.12);
    }
    select{ cursor:pointer; }
    select option{ background:var(--cacao); }
    .submit-btn{
      align-self:center; margin-top:.5rem; cursor:pointer; border:none; font-size:1rem;
      padding:15px 44px; border-radius:60px;
      background:linear-gradient(135deg,var(--gold) 0%,var(--amber) 100%);
      color:var(--cacao); font-weight:700; letter-spacing:.04em;
      box-shadow:0 8px 30px rgba(212,163,115,.3);
      transition:all .4s cubic-bezier(.16,1,.3,1);
    }
    .submit-btn:hover{ transform:translateY(-3px); box-shadow:0 12px 40px rgba(212,163,115,.45); }

    /* ── BOTTOM LINKS ── */
    .ws-bottom{ padding:3rem 0 4rem; }
    .bottom-row{
      display:flex; gap:2rem; justify-content:center; flex-wrap:wrap;
    }
    .bottom-link{
      color:var(--gold); text-decoration:none; font-weight:600; font-size:.95rem;
      padding:10px 24px; border:1px solid rgba(212,163,115,.2); border-radius:10px;
      transition:all .35s cubic-bezier(.16,1,.3,1);
    }
    .bottom-link:hover{ background:rgba(212,163,115,.08); border-color:rgba(212,163,115,.4); transform:translateY(-2px); }

    /* ── SHARED ── */
    .primary-btn{
      border-radius:12px; padding:13px 26px; font-weight:600; text-decoration:none;
      display:inline-flex; align-items:center; gap:8px;
      transition:all .4s cubic-bezier(.16,1,.3,1);
      background:linear-gradient(135deg,var(--gold),var(--amber)); color:var(--cacao);
      box-shadow:0 8px 32px rgba(212,163,115,.3);
    }
    .primary-btn:hover{ transform:translateY(-3px); box-shadow:0 12px 40px rgba(212,163,115,.4); }

    /* ── RESPONSIVE ── */
    @media(max-width:900px){
      .banner-inner{ flex-direction:column; text-align:center; gap:1.5rem; }
      .products-grid{ grid-template-columns:repeat(2,1fr); }
    }
    @media(max-width:640px){
      .container{ padding:0 1.25rem; }
      .form-row{ grid-template-columns:1fr; }
      .features-grid{ grid-template-columns:1fr; }
      .story-grid{ grid-template-columns:1fr; }
      .products-grid{ grid-template-columns:1fr; }
      .hero-actions{ flex-direction:column; align-items:center; }
      .hero-cta-primary,.hero-cta-secondary{ width:100%; max-width:300px; text-align:center; }
      .bottom-row{ flex-direction:column; align-items:center; }
      .bottom-link{ width:100%; max-width:280px; text-align:center; }
    }
  </style>
</Layout>